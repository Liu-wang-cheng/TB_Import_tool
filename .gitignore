# 凭证和配置（含敏感信息，不提交）
configs/*.yaml

# 训练数据和模型（协同学习共享文件除外）
data/*
data/pdf_extracts/
# 协同学习共享文件 - 必须跟踪以支持多用户知识共享
!data/knowledge_base.jsonl
!data/knowledge_feedback.yaml
!data/classifier_model.pkl

# 构建产物
dist/
dist_v*/
build/
*.exe
*.zip
*.bak
.eggs/
*.egg-info/

# 运行产物
logs/
exports/
tools/exports/

# Python 缓存
__pycache__/
*.py[cod]

# 生成的报告
batch_report_*.html

# 下载/缓存数据
cache/

# 旧参考工具
Cp3LogTool*/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 临时文件
build.log
_update_replace.bat
_update_extracted/
